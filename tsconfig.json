{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",

    "rootDir": ".",
    "outDir": "./dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "strict": false,
    "skipLibCheck": true,

  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}